############################################
# Runtime outputs / artifacts (must NOT commit)
############################################

# Model outputs served by gateway (runtime)
outputs/**
!outputs/.gitkeep

# Logs (runtime)
logs/**
!logs/.gitkeep

# CLI test outputs (runtime proofs, images, logs)
cli_tests/out/**
!cli_tests/out/.gitkeep

# Temp gateway/backend logs created by tests
cli_tests/**/out/**/*.log
cli_tests/**/out/**/*.png
cli_tests/**/out/**/*.jpg
cli_tests/**/out/**/*.jpeg
cli_tests/**/out/**/*.webp
cli_tests/**/out/**/*.json
cli_tests/**/out/**/*.txt
cli_tests/**/out/**/*.csv

############################################
# Python cache / venv / build
############################################
__pycache__/
**/__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/
backend/venv/
**/.venv/

# PyTorch / HF / cache (optional, but usually huge)
.cache/
**/.cache/
torch_cache/
**/torch_cache/

############################################
# Node / frontend (if any leftovers)
############################################
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
**/dist/

############################################
# OS / editor / IDE
############################################
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

############################################
# Common temp files
############################################
nohup.out
*.tmp
*.bak
*.backup
*.orig
*.patch
*.rej

############################################
# Local env files / secrets
############################################
.env
.env.*
!.env.example
**/*.key
**/*.pem
**/*secret*
**/*token*

############################################
# (Optional) Large model directories - keep OUT of repo
############################################
models/**
/root/models/**

# --- runtime artifacts / evidence (scheme A) ---
reports/
reports.tgz

# test outputs (keep local evidence, don't commit)
# (cli_tests/out patterns already listed above)

# logs and outputs (generated at runtime)
# (logs/ and outputs/ already covered above with recursive ignores)

# common local artifacts
*.log
*.tgz
*.zip
*.tar
*.tar.gz
